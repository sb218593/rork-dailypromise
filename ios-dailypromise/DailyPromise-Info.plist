	  email into the app: dailypromise://auth-callback
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>app.rork.ttexbyp0kww929p0x5t3t.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>dailypromise</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
